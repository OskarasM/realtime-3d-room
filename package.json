{
  "name": "realtime-3d-room",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A shared 3D room. React Three Fiber for the scene, Supabase Realtime for everyone else in it.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
