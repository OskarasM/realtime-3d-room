# Copy to .env and fill in from your Supabase project:
#   Dashboard -> Project Settings -> API Keys
#
# The publishable key is safe to ship in a browser bundle. It is the key that
# the anon and authenticated Postgres roles use, and Row Level Security is what
# actually protects your data. Never put a secret/service_role key in here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Older projects call the same key the "anon key" and it starts with eyJ...
# Either name works; the app reads PUBLISHABLE first and falls back to ANON.
# VITE_SUPABASE_ANON_KEY=
